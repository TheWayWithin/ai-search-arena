# Database (Neon serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# OpenRouter (AI model gateway)
OPENROUTER_API_KEY=""

# Cloudflare R2 (evidence artifact storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="aisearcharena-evidence"
R2_PUBLIC_URL=""

# Resend (transactional email)
RESEND_API_KEY=""

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=""

# Plausible (analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="aisearcharena.com"

# Buttondown (newsletter signup)
NEXT_PUBLIC_BUTTONDOWN_USERNAME="watters"

# Application
NEXT_PUBLIC_SITE_URL="https://aisearcharena.com"

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=   # Base64-encoded bcrypt hash: Buffer.from(bcryptjs.hashSync("password", 12)).toString("base64")
JWT_SECRET=            # crypto.randomBytes(32).toString("hex")
